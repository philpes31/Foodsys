# Supabase → botão "Connect" → Connection string → aba "Transaction pooler" (porta 6543).
# Troque [YOUR-PASSWORD] pela senha do banco (caracteres especiais precisam de URL-encode).
DATABASE_URL=postgresql://postgres.SEU_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# E-mail de recuperação de senha (resend.com). Sem a chave, o link só aparece no log do servidor.
RESEND_API_KEY=
MAIL_FROM="Mesa Viva <contato@seudominio.com.br>"

# Criptografia das credenciais de pagamento: qualquer texto longo e aleatório (mín. 32 caracteres). Guarde só na Vercel.
APP_ENCRYPTION_KEY=
# Opcional: segredo de assinatura do webhook (Mercado Pago → Suas integrações → Webhooks)
MP_WEBHOOK_SECRET=
